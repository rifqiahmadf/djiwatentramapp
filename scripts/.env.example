# Copy to .env.local (Bun/Vite) or export through your service environment.

# Deployment configuration; VITE_* is public, never put secrets here.
SUPABASE_URL=https://supabase.djiwatentram.web.id
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server paths and deployment targets (export before running scripts).
APP_ROOT=/opt/djiwatentramapp
SUPABASE_SELFHOST_DIR=/opt/supabase-selfhost
SERVICE_HOME=/home/ubuntu
ROOT_SERVICE_HOME=/root
POS_DOMAIN=pos.djiwatentram.web.id
ADMIN_DOMAIN=admin.djiwatentram.web.id
CUSTOMER_DOMAIN=djiwatentram.web.id
KARYAWAN_DOMAIN=karyawan.djiwatentram.web.id
KOL_DOMAIN=kol.djiwatentram.web.id

# Must contain exported scheduler configuration, not shell-generated secret values.
RUNTIME_ENV_FILE=/etc/djiwatentramapp/runtime.env
