# syntax=docker/dockerfile:1
FROM node:24-bookworm-slim AS manifests
WORKDIR /source
COPY . .
RUN node scripts/collect-workspace-manifests.mjs /source /manifests

FROM node:24-bookworm-slim
WORKDIR /app
RUN --mount=type=secret,id=proxy_ca \
    if [ -f /run/secrets/proxy_ca ]; then export NODE_EXTRA_CA_CERTS=/run/secrets/proxy_ca; fi; \
    npm install --global bun@1.3.4 --no-audit --no-fund
COPY --from=manifests /manifests/ ./
RUN --mount=type=secret,id=proxy_ca \
    if [ -f /run/secrets/proxy_ca ]; then export NODE_EXTRA_CA_CERTS=/run/secrets/proxy_ca; fi; \
    bun install --frozen-lockfile
COPY --chown=node:node . .
WORKDIR /app/apps/auth-server
USER node
ENV NODE_ENV=production
ENV PORT=3001
EXPOSE 3001
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s CMD node -e "fetch('http://127.0.0.1:3001/api/health').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
CMD ["bun", "src/index.ts"]
