[Unit]
Description=Better Auth Server for Djiwa Tentram
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
User=${AUTH_SERVICE_USER}
WorkingDirectory=${AUTH_SERVICE_WORKDIR}
EnvironmentFile=${AUTH_SERVICE_ENV_FILE}
ExecStart=${BUN_EXECUTABLE} src/index.ts
Restart=always
RestartSec=5

Environment=BETTER_AUTH_PORT=3001




[Install]
WantedBy=multi-user.target
