# Supabase (Self-Hosted)
# Local dev: http://localhost:8099 (Kong proxy)
# Production via nginx: https://supabase.yumme.id
VITE_SUPABASE_URL=https://supabase.yumme.id
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_STORAGE_BUCKET=app-assets

# Mayar Headless API (Payment Gateway)
	VITE_APP_BASE_URL=https://pos.yumme.id
VITE_AUTH_URL=http://localhost:3000

# ─── Onboarding Admin (Edge Function auth) ───────────────
# Secret untuk autentikasi ke Supabase Edge Function onboarding-admin.
# Harus sama dengan ONBOARDING_ADMIN_SECRET di Supabase secrets:
#   supabase secrets set ONBOARDING_ADMIN_SECRET=your-secret-here
VITE_ADMIN_SECRET=
# Telegram Report Chat ID (opsional, override TELEGRAM_CHAT_ID di Supabase secrets)
# Grup Telegram: angka negatif, contoh: -1001234567890
# Tambahkan juga TELEGRAM_BOT_TOKEN dan TELEGRAM_CHAT_ID di:
#   Supabase Dashboard → Edge Functions → Manage secrets
VITE_TELEGRAM_REPORT_CHAT_ID=-1001234567890

# Deployment configuration; VITE_* is public, never put secrets here.
VITE_API_ORIGIN=https://api.djiwatentram.web.id
VITE_CUSTOMER_ORIGIN=https://djiwatentram.web.id
VITE_BOOKING_ORIGIN=https://booking.djiwatentram.web.id
VITE_B2B_ORIGIN=https://b2b.djiwatentram.web.id
VITE_MERCHANDISE_ORIGIN=https://merchandise.djiwatentram.web.id
VITE_ORDERMIEYAMIN_ORIGIN=https://ordermieyamin.djiwatentram.web.id
VITE_KOPITASIK_ORIGIN=https://kopitasik.djiwatentram.web.id
VITE_KOL_ORIGIN=https://kol.djiwatentram.web.id
VITE_KARYAWAN_ORIGIN=https://karyawan.djiwatentram.web.id
VITE_REKRUTMEN_ORIGIN=https://rekrutmen.djiwatentram.web.id
VITE_POS_ORIGIN=https://pos.djiwatentram.web.id
VITE_ADMIN_ORIGIN=https://admin.djiwatentram.web.id
VITE_PAY_ORIGIN=https://pay.djiwatentram.web.id
VITE_INVESTOR_ORIGIN=https://investor.djiwatentram.web.id
VITE_ANALYZER_URL=http://127.0.0.1:8002
VITE_REPORT_SERVICE_URL=http://127.0.0.1:8001
VITE_AI_PARSER_URL=http://127.0.0.1:8002
VITE_CUSTOMER_COMMUNITY_API_URL=
VITE_PAY_RETURN_ORIGINS=https://djiwatentram.yumme.id,https://djiwatentram.web.id,https://b2b.djiwatentram.web.id,https://merchandise.djiwatentram.web.id,https://pos.djiwatentram.web.id,https://admin.djiwatentram.web.id
